generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SCANNER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(CUSTOMER)
  bookings  Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  durationMin Int
  language    String
  genre       String
  releaseDate DateTime?
  posterUrl   String?
  trailerUrl  String?
  shows       Show[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Cinema {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  city      String
  screens   Screen[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
}

model Screen {
  id        Int      @id @default(autoincrement())
  name      String
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id])
  seats     Seat[]
  shows     Show[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cinemaId, name])
}

model Seat {
  id        Int      @id @default(autoincrement())
  row       String
  number    Int
  type      SeatType @default(REGULAR)
  screenId  Int
  bookingSeats BookingSeat[]
  screen    Screen   @relation(fields: [screenId], references: [id])
  createdAt DateTime @default(now())

  @@unique([screenId, row, number])
}

model Show {
  id        Int      @id @default(autoincrement())
  movieId   Int
  screenId  Int
  startTime DateTime
  endTime   DateTime
  price     Decimal  @db.Decimal(10, 2)
  movie     Movie    @relation(fields: [movieId], references: [id])
  screen    Screen   @relation(fields: [screenId], references: [id])
  bookings  Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movieId])
  @@index([screenId])
  @@index([startTime])
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int
  showId      Int
  status      BookingStatus @default(PENDING)
  totalAmount Decimal       @db.Decimal(10, 2)
  expiresAt   DateTime?
  bookingSeats BookingSeat[]
  payment     Payment?
  ticket      Ticket?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
  show Show @relation(fields: [showId], references: [id])

  @@index([userId])
  @@index([showId])
  @@index([status])
  @@index([expiresAt])
}

model BookingSeat {
  id        Int      @id @default(autoincrement())
  bookingId Int
  showId    Int
  seatId    Int
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  seat    Seat    @relation(fields: [seatId], references: [id])

  @@unique([bookingId, seatId])
  @@unique([showId, seatId])
  @@index([seatId])
  @@index([showId])
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id                Int           @id @default(autoincrement())
  bookingId         Int           @unique
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status])
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

model Ticket {
  id        Int          @id @default(autoincrement())
  bookingId Int          @unique
  qrToken   String       @unique
  status    TicketStatus @default(ACTIVE)
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([status])
}